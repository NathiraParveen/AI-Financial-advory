# ============================================================
# Investment Advisor — Environment Configuration Template
# Copy this file to .env.local and fill in your values
# ============================================================

# ===== Database =====
# SQLite (default, no installation needed)
DATABASE_URL=file:./prisma/dev.db

# ===== Server =====
PORT=5000
NODE_ENV=development
LOG_LEVEL=debug

# ===== Auth =====
JWT_SECRET=your-secret-key-here-change-in-production
JWT_EXPIRATION=7d

# ===== CORS =====
CORS_ORIGIN=http://localhost:3000

# ===== File Upload =====
MAX_FILE_SIZE=10485760
UPLOAD_DIR=./uploads

# ===== Feature Flags =====
ENABLE_CSV_IMPORT=true
ENABLE_TAX_OPTIMIZATION=true
ENABLE_REBALANCING_ALERTS=true

# ============================================================
# AI Configuration (required for AI features)
# ============================================================

# OpenAI API — primary AI provider
OPENAI_API_KEY=sk-your-openai-key-here
OPENAI_MODEL=gpt-4
OPENAI_TEMPERATURE=0.7
OPENAI_MAX_TOKENS=2000

# AI Feature Flags
AI_CHAT_ENABLED=true
AI_FORECAST_ENABLED=true
AI_ANOMALY_DETECTION_ENABLED=true
AI_INSIGHTS_ENABLED=true

# Rate Limiting
AI_REQUESTS_PER_MINUTE=30
AI_REQUESTS_PER_DAY=5000

# Cost Tracking
TRACK_AI_COSTS=true
MAX_COST_PER_USER_MONTHLY=50

# Forecast Configuration
FORECAST_MODEL=arima
FORECAST_LOOKBACK_DAYS=365
FORECAST_CONFIDENCE_THRESHOLD=0.7
FORECAST_CACHE_HOURS=24

# AI Data Retention
CHAT_HISTORY_RETENTION_DAYS=90
ANOMALY_ALERT_RETENTION_DAYS=30

# Logging
AI_LOG_LEVEL=info
AI_LOG_FILE=./logs/ai.log
ENABLE_AI_METRICS=true
