{
  "name": "@ia/backend",
  "version": "1.0.0",
  "description": "Investment Advisor - Backend API",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "npx tsx --tsconfig tsconfig.json src/index.ts",
    "build": "npx tsc",
    "start": "node dist/index.js",
    "db:migrate": "npx prisma migrate dev",
    "db:generate": "npx prisma generate",
    "db:seed": "npx tsx prisma/seed.ts",
    "test": "node --test"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "keywords": [
    "investment",
    "advisor",
    "finance",
    "portfolio"
  ],
  "author": "NathiraParveen",
  "license": "MIT",
  "dependencies": {
    "@prisma/client": "^5.4.1",
    "bcrypt": "^5.1.0",
    "cors": "^2.8.5",
    "csv-parser": "^3.0.0",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.3",
    "multer": "^1.4.5-lts.1",
    "openai": "^6.38.0",
    "prisma": "^5.4.1",
    "simple-statistics": "^7.8.9",
    "winston": "^3.19.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.1",
    "@types/cors": "^2.8.14",
    "@types/express": "^4.17.20",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^1.4.7",
    "@types/node": "^20.8.1",
    "jsonwebtoken": "^9.0.3",
    "ts-node": "^10.9.1",
    "tsx": "^4.22.1",
    "typescript": "^5.2.2"
  }
}
